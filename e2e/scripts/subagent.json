{
  "turns": [
    {
      "match": "explore",
      "repeat": true,
      "events": [
        {
          "type": "subagent",
          "description": "Find the config",
          "prompt": "Find where the config is read.",
          "result": "The config is read in settings.ts.",
          "events": [
            { "type": "tool_use", "name": "Read", "input": { "file_path": "{cwd}{sep}settings.ts" }, "approval": false, "result": "export const config = {}" },
            { "type": "text", "text": "Subagent says the config lives in settings.ts." }
          ]
        },
        { "type": "text", "text": "Main agent: the explorer finished." }
      ]
    },
    {
      "match": "slow",
      "repeat": true,
      "events": [
        {
          "type": "subagent",
          "description": "Wait around",
          "prompt": "Take your time.",
          "events": [
            { "type": "text", "text": "Subagent is still looking." },
            { "type": "wait", "ms": 20000 },
            { "type": "text", "text": "Subagent never says this." }
          ]
        },
        { "type": "text", "text": "Main agent: carried on after the stop." }
      ]
    }
  ]
}
