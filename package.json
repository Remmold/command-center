{
  "name": "command-center",
  "version": "0.1.35",
  "description": "Single-window command center for managing multiple Claude Code projects in parallel.",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "quick": "pnpm typecheck && pnpm test",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts",
    "e2e:gate": "node scripts/e2e-gate.mjs",
    "e2e:count": "node scripts/e2e-count.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "monaco-editor": "0.55.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/diff": "^7.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.14.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.13"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
