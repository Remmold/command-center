#!/bin/sh
# Runs the quick tier (typecheck + tests) before every commit that touches code.
# It checks the working tree, so a half-finished edit left unstaged still fails the commit.

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0
if ! printf '%s\n' "$staged" | grep -qvE '\.md$'; then
  exit 0
fi

echo "pre-commit: running pnpm quick"
if ! pnpm quick; then
  echo "pre-commit: pnpm quick failed; commit blocked" >&2
  exit 1
fi
